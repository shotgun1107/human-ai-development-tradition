        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_of_image": {
          "$ref": "#/$defs/hex_u32"
        },
        "virtual_path": {
          "$ref": "#/$defs/virtual_path"
        },
        "volume_serial": {
          "$ref": "#/$defs/hex_u64"
        }
      },
      "required": [
        "virtual_path",
        "sha256",
        "file_id",
        "volume_serial",
        "pe_machine",
        "pe_timestamp",
        "size_of_image",
        "required_exports"
      ],
      "type": "object"
    },
    "tool_identity": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
