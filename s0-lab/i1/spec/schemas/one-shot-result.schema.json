{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:urc:0.14:i1:one-shot-result",
  "type":"object","additionalProperties":false,
  "required":["record_kind","not_an_s0_run","run_id","request_sha256","response_sha256","response_bytes","parsed_type"],
  "properties": {
    "record_kind":{"const":"i1-public-one-shot-structural-result"},
    "not_an_s0_run":{"const":true},
    "run_id":{"type":"string","pattern":"^[A-Za-z0-9._-]{1,128}$"},
    "request_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "response_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "response_bytes":{"type":"integer","minimum":1,"maximum":8192},
    "parsed_type":{"const":"object"}
  }
}
