{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:urc:0.14:i1:evidence-bundle-structure",
  "type":"object","additionalProperties":false,
  "required":["edge","entry_count","envelope_sha256"],
  "properties": {
    "edge":{"type":"string","pattern":"^(ROOT|E[0-9]{2})$"},
    "entry_count":{"type":"integer","minimum":0,"maximum":3},
    "control_integration_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "envelope_sha256":{"type":"array","maxItems":3,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
  }
}
