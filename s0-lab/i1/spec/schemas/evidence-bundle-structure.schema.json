{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:urc:0.14:i1:evidence-bundle",
  "type":"object",
  "additionalProperties":false,
  "required":["edge","entry_count","envelope_sha256"],
  "properties":{
    "edge":{"enum":["ROOT","E02","E05","E08","E14","E21","E24","E25","E27","E29","E31","E35","E48","E50","E56"]},
    "entry_count":{"type":"integer","minimum":0,"maximum":3},
    "control_integration_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "envelope_sha256":{"type":"array","maxItems":3,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
  },
  "oneOf":[
    {"required":["control_integration_manifest_sha256"],"properties":{"edge":{"const":"ROOT"},"entry_count":{"const":0},"envelope_sha256":{"minItems":0,"maxItems":0}}},
    {"not":{"required":["control_integration_manifest_sha256"]},"properties":{"edge":{"const":"E02"},"entry_count":{"const":3},"envelope_sha256":{"minItems":3,"maxItems":3}}},
    {"not":{"required":["control_integration_manifest_sha256"]},"properties":{"edge":{"enum":["E05","E08","E14","E21","E24","E27","E29","E31","E35","E48","E50","E56"]},"entry_count":{"const":1},"envelope_sha256":{"minItems":1,"maxItems":1}}},
    {"not":{"required":["control_integration_manifest_sha256"]},"properties":{"edge":{"const":"E25"},"entry_count":{"const":2},"envelope_sha256":{"minItems":2,"maxItems":2}}}
  ]
}
