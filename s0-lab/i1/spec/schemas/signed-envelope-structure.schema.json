{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:urc:0.14:i1:signed-envelope-structure",
  "type":"object","additionalProperties":false,
  "required":["signer_role","signer_key_sha256","record_length","record_sha256","signature_algorithm","signature_hex"],
  "properties": {
    "signer_role":{"enum":["adjudication-comparison","analysis","analysis-map-comparison","catalog-comparison","comparator-builder-1","comparator-builder-2","comparator-operator-1","comparator-operator-2","content-intake","control-registrar","control-root-authority","final-decision-custodian","judgment-comparison","label-comparison","leakage-comparison","p1-review-comparison","public-record-publisher","representation-builder","scan-comparison","semantic-judge-1","semantic-judge-2","simulation-builder"]},
    "signer_key_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "record_length":{"type":"integer","minimum":1},
    "record_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "signature_algorithm":{"const":"Ed25519"},
    "signature_hex":{"type":"string","pattern":"^[0-9a-f]{128}$"}
  }
}
