{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urc:0.14:i1:public-runtime-topology",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_schema","design_id","implementation_gate","claim_kind","source_sha256","counts","role_rows","stores","edges","signer_roles","payload_receipt_split_edges","status","closed_boundaries"],
  "properties": {
    "spec_schema": {"const":"URC-0.14-I1-PUBLIC-RUNTIME-1"},
    "design_id": {"const":"URC-0.14-CONTROL-INTEGRATED"},
    "implementation_gate": {"const":"S0 V0.14 PUBLIC IMPLEMENTATION PREREQUISITES OPEN"},
    "claim_kind": {"const":"public-runtime-structure-only"},
    "source_sha256": {
      "type":"object",
      "additionalProperties":{"$ref":"#/$defs/sha256"},
      "required":["protocol","contract","plan","review_response","independent_review","control_integration_decision"],
      "minProperties":6,
      "maxProperties":6
    },
    "counts": {
      "type":"object",
      "additionalProperties":false,
      "required":["role_rows","role_positions","paired_role_rows","stores","edge_rows","signer_roles","status_edges","status_states","status_receipts","e51_pairs"],
      "properties": {
        "role_rows":{"const":32},"role_positions":{"const":40},"paired_role_rows":{"const":8},"stores":{"const":27},"edge_rows":{"const":64},"signer_roles":{"const":22},"status_edges":{"const":14},"status_states":{"const":15},"status_receipts":{"const":17},"e51_pairs":{"const":15}
      }
    },
    "role_rows": {"type":"array","minItems":32,"maxItems":32,"items":{"$ref":"#/$defs/roleRow"}},
    "stores": {"type":"array","minItems":27,"maxItems":27,"items":{"$ref":"#/$defs/store"}},
    "edges": {"type":"array","minItems":64,"maxItems":64,"items":{"$ref":"#/$defs/edge"}},
    "signer_roles": {"type":"array","minItems":22,"maxItems":22,"items":{"type":"string","pattern":"^[a-z0-9-]+$"}},
    "payload_receipt_split_edges": {"type":"array","minItems":6,"maxItems":6,"uniqueItems":true,"items":{"$ref":"#/$defs/edgeId"}},
    "status": {
      "type":"object","additionalProperties":false,"required":["edge_order","states","receipts"],
      "properties": {
        "edge_order":{"type":"array","minItems":14,"maxItems":14,"items":{"$ref":"#/$defs/edgeId"}},
        "states":{"type":"array","minItems":15,"maxItems":15,"items":{"type":"string","pattern":"^A-[0-9a-f]{4}$"}},
        "receipts":{"type":"array","minItems":14,"maxItems":14,"items":{"$ref":"#/$defs/receiptRow"}}
      }
    },
    "closed_boundaries":{"type":"array","minItems":8,"items":{"type":"string","minLength":1}}
  },
  "$defs": {
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "edgeId":{"type":"string","pattern":"^(E00[A-H]|E(0[1-9]|[1-4][0-9]|5[0-6]))$"},
    "edgeList":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/edgeId"}},
    "roleRow": {
      "type":"object","additionalProperties":false,"required":["id","label","positions","inbound_edges","outbound_edges"],
      "properties": {
        "id":{"type":"string","pattern":"^[a-z0-9-]+$"},
        "label":{"type":"string","minLength":1},
        "positions":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"type":"string","enum":["single","A","B","1","2"]}},
        "inbound_edges":{"$ref":"#/$defs/edgeList"},
        "outbound_edges":{"$ref":"#/$defs/edgeList"}
      }
    },
    "access": {
      "type":"object","additionalProperties":false,"required":["role","position","edges"],
      "properties": {
        "role":{"type":"string","pattern":"^[a-z0-9-]+$"},
        "position":{"type":"string","enum":["single","A","B","1","2"]},
        "edges":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/edgeId"}},
        "scope":{"type":"string","minLength":1}
      }
    },
    "store": {
      "type":"object","additionalProperties":false,"required":["id","writer","readers"],
      "properties": {
        "id":{"type":"string","pattern":"^[A-Za-z0-9-]+$"},
        "writer":{"$ref":"#/$defs/access"},
        "readers":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/access"}}
      }
    },
    "edge": {
      "type":"object","additionalProperties":false,"required":["id","kind"],
      "properties": {
        "id":{"$ref":"#/$defs/edgeId"},
        "kind":{"enum":["public-grant","operational","status-evidence","status-pair-write","status-chain-read","publication-pair-write","publication-read"]}
      }
    },
    "receiptEntry": {
      "type":"object","additionalProperties":false,"required":["producer_role","artifact_kind"],
      "properties": {
        "producer_role":{"type":"string","pattern":"^[a-z0-9-]+$"},
        "artifact_kind":{"type":"string","pattern":"^[a-z0-9-]+$"}
      }
    },
    "receiptRow": {
      "type":"object","additionalProperties":false,"required":["edge","entries"],
      "properties": {
        "edge":{"$ref":"#/$defs/edgeId"},
        "entries":{"type":"array","minItems":1,"maxItems":3,"items":{"$ref":"#/$defs/receiptEntry"}}
      }
    }
  }
}
